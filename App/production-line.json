[
    {
        "id": "dispenser01",
        "name": "GlueValve",
        "driverType": "Modbus",
        "ipAddress": "192.168.1.30",
        "port": 502,
        "stationAddress": 1,
        "cpuSlot": 0,
        "cycleTimeMs": 1000,
        "timeoutMs": 3000,
        "retryCount": 3,
        "description": "点胶阀（数字 ValveState + 模拟 PressureSet/FlowSet 两套）",
        "tags": [
            {
                "id": "dispenser01-pressure",
                "name": "Pressure",
                "modbusAddress": "40001",
                "dataType": "Float32",
                "access": "Read",
                "unit": "bar",
                "description": "胶阀压力"
            },
            {
                "id": "dispenser01-flow",
                "name": "Flow",
                "modbusAddress": "40002",
                "dataType": "Float32",
                "access": "Read",
                "unit": "ml/min",
                "description": "胶阀流量"
            },
            {
                "id": "dispenser01-temperature",
                "name": "Temperature",
                "modbusAddress": "40003",
                "dataType": "Float32",
                "access": "Read",
                "unit": "°C",
                "description": "胶阀温度"
            },
            {
                "id": "dispenser01-valvestate",
                "name": "ValveState",
                "modbusAddress": "00016",
                "dataType": "Bool",
                "access": "ReadWrite",
                "description": "开关阀 On/Off"
            },
            {
                "id": "dispenser01-pressureset",
                "name": "PressureSet",
                "modbusAddress": "40006",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "bar",
                "description": "压力设定值"
            },
            {
                "id": "dispenser01-flowset",
                "name": "FlowSet",
                "modbusAddress": "40007",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "ml/min",
                "description": "流量设定值"
            },
            {
                "id": "dispenser01-materiallevel",
                "name": "MaterialLevel",
                "modbusAddress": "40004",
                "dataType": "Float32",
                "access": "Read",
                "unit": "%",
                "description": "料位"
            },
            {
                "id": "dispenser01-cumulativevolume",
                "name": "CumulativeVolume",
                "modbusAddress": "40005",
                "dataType": "Float32",
                "access": "Read",
                "unit": "ml",
                "description": "累计体积"
            },
            {
                "id": "dispenser01-remainingglue",
                "name": "RemainingGlue",
                "modbusAddress": "40008",
                "dataType": "Float32",
                "access": "Read",
                "unit": "ml",
                "templateId": "dp-glue-remaining",
                "description": "剩余胶量（趋势点：料罐剩余胶量，随消耗下降；dp-glue-remaining 模拟量/液位类模板）"
            }
        ]
    },
