<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Off"
      internalLogFile="${specialfolder:folder=CommonApplicationData:cached=true}/DispensVisTrace/logs/nlog-internal.log">

  <!--
    ==========================================================================
    DispensVisTrace 日志配置
    ==========================================================================
    落盘位置：%ProgramData%\DispensVisTrace\logs
        app-yyyy-MM-dd.log    全量日志（异步写入，保留 30 天且最多 60 个文件）
        error-yyyy-MM-dd.log  仅 Error/Fatal（同步写入，保留 90 天）
    该文件随程序发布到 exe 同目录（见 App.csproj），现场改完保存即生效（autoReload），
    无需重启程序。

    排障提示：日志没有输出时，把上面的 internalLogLevel 由 Off 改成 Debug，
    NLog 会把自身装载与写入的详细过程记录到 internalLogFile。
    ==========================================================================
  -->

  <variable name="logDir" value="${specialfolder:folder=CommonApplicationData:cached=true}/DispensVisTrace/logs" />

  <variable name="logLayout" value="${longdate}|${level:uppercase=true:padding=-5}|t${threadid:padding=3}|${logger:shortName=true}|${message:withexception=true}" />

  <!-- 现场可改成 Info 显著降低写入量；Trace/Debug 用于研发与问题复现 -->
  <variable name="fileMinLevel" value="Debug" />

  <targets>
    <!--
      全量日志：异步写入，避免视觉检测/运动控制线程被磁盘 I/O 阻塞。
      队列积压到上限时丢弃最旧的消息——Error/Fatal 另有下面同步落盘的通道兜底，
      因此这里丢弃不会导致关键错误丢失。
    -->
    <target name="appLog" xsi:type="AsyncWrapper"
            queueLimit="20000"
            overflowAction="Discard"
            batchSize="200"
            timeToSleepBetweenBatches="50">
      <target xsi:type="File"
              fileName="${logDir}/app-${shortdate}.log"
              layout="${logLayout}"
              header="===== DispensVisTrace ${assembly-version} 日志开始 @ ${longdate} ====="
              encoding="utf-8"
              writeBom="true"
              createDirs="true"
              keepFileOpen="true"
              autoFlush="true"
              maxArchiveDays="30"
              maxArchiveFiles="60" />
    </target>

    <!--
      错误日志：同步写入，保证进程异常终止前 Error/Fatal 已经落盘。
      不使用 ${callsite}：Error 都经由 LogService 转发，取到的永远是 LogService.Log，
      真正有用的来源信息在 ${logger} 里（业务代码请用 log.ForContext<T>() 取名）。
    -->
    <target name="errorLog" xsi:type="File"
            fileName="${logDir}/error-${shortdate}.log"
            layout="${logLayout}"
            header="===== DispensVisTrace ${assembly-version} 错误日志开始 @ ${longdate} ====="
            encoding="utf-8"
            writeBom="true"
            createDirs="true"
            keepFileOpen="true"
            autoFlush="true"
            maxArchiveDays="90" />

    <!-- 附加到调试器时输出到 Visual Studio 输出窗口；未附加调试器时几乎零开销 -->
    <target name="debugger" xsi:type="Debugger"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message:withexception=true}" />
  </targets>

  <rules>
    <!-- Error/Fatal 单独留档，便于现场快速定位；不写 final，后面两条规则继续生效 -->
    <logger name="*" minlevel="Error" writeTo="errorLog" />

    <logger name="*" minlevel="${fileMinLevel}" writeTo="appLog" />

    <logger name="*" minlevel="Debug" writeTo="debugger" />
  </rules>
</nlog>
