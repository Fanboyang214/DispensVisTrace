<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UserSecretsId>85a89e79-6358-48bf-8999-9608023624f8</UserSecretsId>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="NLog" Version="6.2.1" />
    <!-- 桥接：把 Microsoft.Extensions.Logging 的日志写进 NLog.config 定义的目标，
         使 ILogger<T> 与 Core.Logging.ILogService 汇合到同一批日志文件。
         版本需与 NLog 同步，否则 NU1605 会把 NLog 判为降级 -->
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.1" />
    <PackageReference Include="Prism.Unity" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calibration\Calibration.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NLog 在 exe 同目录按文件名自动装载 NLog.config -->
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
