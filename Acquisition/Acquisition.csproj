<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <!-- AcquisitionHost 实现 IHostedService 需要本包 -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="MvCameraControl.Net" Version="1.1.0" />
    <!-- AcquisitionModule 实现 Prism 的 IModule（与 Calibration 同一做法）；
         View 往区域注册要用 Prism.Wpf，它传递引入 Prism.Core -->
    <PackageReference Include="Prism.Wpf" Version="8.1.97" />
  </ItemGroup>

  <ItemGroup>
    <!-- 注意：本模块日志一律走 Core.Logging.ILogService，不引用任何日志框架/包 -->
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>