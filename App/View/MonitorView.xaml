<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:App.View"
             xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="App.View.MonitorView"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="750">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#2b2b2b" HorizontalAlignment="Right" Width="1"/>
        <StackPanel>

            <Border BorderBrush="Black"  Height="250" >
                <Grid>
                    <Image x:Name="LocateImage" Source="{Binding LocateImageSource}" Stretch="None"/>
                    <Canvas x:Name="LocateCanvas"  IsHitTestVisible="False"/>
                </Grid>

            </Border>
        </StackPanel>
        <Border Grid.Column="1" Background="#2b2b2b" HorizontalAlignment="Right" Width="1"/>

        <StackPanel Grid.Column="1">
            <Border BorderBrush="Black"  Height="250" >
                <Grid>
                    <Image x:Name="DispenseImage" Source="{Binding DispenseImageSource}" Stretch="None"/>
                    <Canvas x:Name="DispenseCanvas"  IsHitTestVisible="False"/>
                </Grid>

            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <Border BorderBrush="Black"  Height="250" >
                <Grid>
                    <Image x:Name="InspectionImage" Source="{Binding InspectionImageSource}" Stretch="None"/>
                    <Canvas x:Name="InspectionCanvas"  IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </StackPanel>

    </Grid>
</UserControl>
