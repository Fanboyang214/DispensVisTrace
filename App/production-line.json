[
    {
        "id": "dispenser01",
        "name": "GlueValve",
        "driverType": "Modbus",
        "ipAddress": "192.168.1.30",
        "port": 502,
        "stationAddress": 1,
        "cpuSlot": 0,
        "cycleTimeMs": 1000,
        "timeoutMs": 3000,
        "retryCount": 3,
        "description": "点胶阀（数字 ValveState + 模拟 PressureSet/FlowSet 两套）",
        "tags": [
            {
                "id": "dispenser01-pressure",
                "name": "Pressure",
                "modbusAddress": "40001",
                "dataType": "Float32",
                "access": "Read",
                "unit": "bar",
                "description": "胶阀压力"
            },
            {
                "id": "dispenser01-flow",
                "name": "Flow",
                "modbusAddress": "40002",
                "dataType": "Float32",
                "access": "Read",
                "unit": "ml/min",
                "description": "胶阀流量"
            },
            {
                "id": "dispenser01-temperature",
                "name": "Temperature",
                "modbusAddress": "40003",
                "dataType": "Float32",
                "access": "Read",
                "unit": "°C",
                "description": "胶阀温度"
            },
            {
                "id": "dispenser01-valvestate",
                "name": "ValveState",
                "modbusAddress": "00016",
                "dataType": "Bool",
                "access": "ReadWrite",
                "description": "开关阀 On/Off"
            },
            {
                "id": "dispenser01-pressureset",
                "name": "PressureSet",
                "modbusAddress": "40006",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "bar",
                "description": "压力设定值"
            },
            {
                "id": "dispenser01-flowset",
                "name": "FlowSet",
                "modbusAddress": "40007",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "ml/min",
                "description": "流量设定值"
            },
            {
                "id": "dispenser01-materiallevel",
                "name": "MaterialLevel",
                "modbusAddress": "40004",
                "dataType": "Float32",
                "access": "Read",
                "unit": "%",
                "description": "料位"
            },
            {
                "id": "dispenser01-cumulativevolume",
                "name": "CumulativeVolume",
                "modbusAddress": "40005",
                "dataType": "Float32",
                "access": "Read",
                "unit": "ml",
                "description": "累计体积"
            },
            {
                "id": "dispenser01-remainingglue",
                "name": "RemainingGlue",
                "modbusAddress": "40008",
                "dataType": "Float32",
                "access": "Read",
                "unit": "ml",
                "templateId": "dp-glue-remaining",
                "description": "剩余胶量（趋势点：料罐剩余胶量，随消耗下降；dp-glue-remaining 模拟量/液位类模板）"
            }
        ]
    },
    {
        "id": "motion01",
        "name": "MotionPlatForm",
        "driverType": "Zmotion",
        "ipAddress": "192.168.1.31",
        "cycleTimeMs": 200,
        "timeoutMs": 3000,
        "retryCount": 3,
        "description": "运动平台（正运动运动控制卡 ZMC/ZBasic；配方程序常驻卡上一次，每颗产品只传位姿；轴0/1/2 = X/Y/Z）",
        "tags": [
            {
                "id": "motion01-x",
                "name": "X",
                "address": "axis0.dpos",
                "dataType": "Float32",
                "access": "Read",
                "unit": "mm",
                "description": "X 轴指令位置（DPOS，轴0）"
            },
            {
                "id": "motion01-y",
                "name": "Y",
                "address": "axis1.dpos",
                "dataType": "Float32",
                "access": "Read",
                "unit": "mm",
                "description": "Y 轴指令位置（DPOS，轴1）"
            },
            {
                "id": "motion01-z",
                "name": "Z",
                "address": "axis2.dpos",
                "dataType": "Float32",
                "access": "Read",
                "unit": "mm",
                "description": "Z 轴指令位置（DPOS，轴2）"
            },
            {
                "id": "motion01-speedx",
                "name": "SpeedX",
                "address": "axis0.speed",
                "dataType": "Float32",
                "access": "Read",
                "unit": "mm/s",
                "description": "X 轴当前速度（SPEED，轴0）"
            },
            {
                "id": "motion01-speedy",
                "name": "SpeedY",
                "address": "axis1.speed",
                "dataType": "Float32",
                "access": "Read",
                "unit": "mm/s",
                "description": "Y 轴当前速度（SPEED，轴1）"
            },
            {
                "id": "motion01-speedz",
                "name": "SpeedZ",
                "address": "axis2.speed",
                "dataType": "Float32",
                "access": "Read",
                "unit": "mm/s",
                "description": "Z 轴当前速度（SPEED，轴2）"
            },
            {
                "id": "motion01-inpositionx",
                "name": "InPositionX",
                "address": "axis0.idle",
                "dataType": "Bool",
                "access": "Read",
                "description": "X 轴静止/运动完成（IDLE=1，轴0）"
            },
            {
                "id": "motion01-inpositiony",
                "name": "InPositionY",
                "address": "axis1.idle",
                "dataType": "Bool",
                "access": "Read",
                "description": "Y 轴静止/运动完成（IDLE=1，轴1）"
            },
            {
                "id": "motion01-inpositionz",
                "name": "InPositionZ",
                "address": "axis2.idle",
                "dataType": "Bool",
                "access": "Read",
                "description": "Z 轴静止/运动完成（IDLE=1，轴2）"
            },
            {
                "id": "motion01-homedx",
                "name": "HomedX",
                "address": "axis0.homed",
                "dataType": "Bool",
                "access": "Read",
                "description": "X 轴回零完成（具体状态位/指令待联调确认，轴0）"
            },
            {
                "id": "motion01-homedy",
                "name": "HomedY",
                "address": "axis1.homed",
                "dataType": "Bool",
                "access": "Read",
                "description": "Y 轴回零完成（具体状态位/指令待联调确认，轴1）"
            },
            {
                "id": "motion01-homedz",
                "name": "HomedZ",
                "address": "axis2.homed",
                "dataType": "Bool",
                "access": "Read",
                "description": "Z 轴回零完成（具体状态位/指令待联调确认，轴2）"
            },
            {
                "id": "motion01-targetx",
                "name": "TargetX",
                "address": "axis0.target",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "mm",
                "description": "jog/回零目标 X（写完由 MoveCmd 触发单轴定位，如 MOVEABS）"
            },
            {
                "id": "motion01-targety",
                "name": "TargetY",
                "address": "axis1.target",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "mm",
                "description": "jog/回零目标 Y（写完由 MoveCmd 触发单轴定位，如 MOVEABS）"
            },
            {
                "id": "motion01-movecmd",
                "name": "MoveCmd",
                "address": "jog.move",
                "dataType": "Bool",
                "access": "ReadWrite",
                "description": "jog/回零单步触发"
            },
            {
                "id": "motion01-programerror",
                "name": "ProgramError",
                "address": "program.error",
                "dataType": "Int32",
                "access": "Read",
                "description": "卡上程序错误码（0=正常；9001=阀门时序未实现；9002=变换后越软限位）——非 0 必须停机报警。轨迹不进资源树，装载由 IMotionCardService.DownloadProgram 负责"
            },
            {
                "id": "motion01-programrunning",
                "name": "ProgramRunning",
                "address": "program.running",
                "dataType": "Bool",
                "access": "Read",
                "description": "卡上程序正在跑本颗产品（只读镜像；启动由 IMotionCardService.StartProgram 负责）"
            },
            {
                "id": "motion01-programdone",
                "name": "ProgramDone",
                "address": "program.done",
                "dataType": "Bool",
                "access": "Read",
                "description": "本颗产品已跑完（只读镜像；中断由 IMotionCardService.StopProgram 负责）"
            },
            {
                "id": "motion01-safetransitheight",
                "name": "SafeTransitHeight",
                "address": "param.safe_transit_height",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "mm",
                "description": "安全通行高度（上位机写入配置）"
            },
            {
                "id": "motion01-zalarmheight",
                "name": "ZAlarmHeight",
                "address": "param.z_alarm_height",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "mm",
                "description": "Z轴警戒高度"
            },
            {
                "id": "motion01-cameralensheight",
                "name": "CameraLensHeight",
                "address": "param.camera_lens_height",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "mm",
                "description": "Camera01 镜头最低点高度"
            },
            {
                "id": "motion01-camerafpxmin",
                "name": "CameraFootprintXMin",
                "address": "param.camera_footprint_x_min",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "mm",
                "description": "Camera01 投影区域 X 最小值"
            },
            {
                "id": "motion01-camerafpxmax",
                "name": "CameraFootprintXMax",
                "address": "param.camera_footprint_x_max",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "mm",
                "description": "Camera01 投影区域 X 最大值"
            },
            {
                "id": "motion01-camerafpymin",
                "name": "CameraFootprintYMin",
                "address": "param.camera_footprint_y_min",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "mm",
                "description": "Camera01 投影区域 Y 最小值"
            },
            {
                "id": "motion01-camerafpymax",
                "name": "CameraFootprintYMax",
                "address": "param.camera_footprint_y_max",
                "dataType": "Float32",
                "access": "ReadWrite",
                "unit": "mm",
                "description": "Camera01 投影区域 Y 最大值"
            },
            {
                "id": "motion01-safetystatus",
                "name": "SafetyStatus",
                "address": "status.safety",
                "dataType": "String",
                "access": "Read",
                "enum": [ "safe", "warning", "critical" ],
                "description": "当前安全状态（enum 映射为 String）"
            }
        ]
    },
    {
