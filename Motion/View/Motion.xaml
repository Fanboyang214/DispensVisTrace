<UserControl x:Class="Motion.View.Motion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Motion.View"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1280"
             Background="Transparent"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             FontSize="12"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MotionTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═════════ 页头：控制器状态 ═════════ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="运动控制" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="MOTION CONTROL · 参数 / 回零 / 调试 / 前瞻"
                               Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse>
                        <Ellipse.Style>
                            <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding CardStatusText}" Foreground="{StaticResource TextPrimary}"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CardStatusHint}" Style="{StaticResource CaptionText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════ X / Y / Z + 前瞻 ═════════ -->
        <TabControl Grid.Row="1" Style="{StaticResource MotionTabControl}"
                    ItemContainerStyle="{StaticResource MotionTabItem}">

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="X 轴" Margin="7,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <local:AxisMotion DataContext="{Binding XAxis}" />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" VerticalAlignment="Center" />
                        <TextBlock Text="Y 轴" Margin="7,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <local:AxisMotion DataContext="{Binding YAxis}" />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentAmber}" VerticalAlignment="Center" />
                        <TextBlock Text="Z 轴" Margin="7,0,0,0" />
                    </StackPanel>
                </TabItem.Header>
                <local:AxisMotion DataContext="{Binding ZAxis}" Loaded="AxisMotion_Loaded" />
            </TabItem>

            <TabItem Header="前瞻设置">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- ───────── 控制器前瞻 ───────── -->
                    <Border Grid.Column="0" Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="控制器前瞻" Style="{StaticResource PanelTitleText}" />
                                        <TextBlock Text="LOOK AHEAD" Style="{StaticResource CaptionText}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="保存前瞻参数" Style="{StaticResource PrimaryButton}"
                                            Padding="10,4" Command="{Binding SaveLookaheadCommand}" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="拐角模式" Style="{StaticResource FieldLabelText}" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 Text="{Binding CornerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="模式" Style="{StaticResource UnitText}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="限制半径" Style="{StaticResource FieldLabelText}" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 Text="{Binding FullSpeedRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource UnitText}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="最小速度" Style="{StaticResource FieldLabelText}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 Text="{Binding MinSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="mm/s" Style="{StaticResource UnitText}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="倒角半径 *" Style="{StaticResource FieldLabelText}"
                                                   ToolTip="控制器侧未确认参数地址，暂不下发" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 IsEnabled="False"
                                                 ToolTip="控制器侧未确认参数地址，暂不下发"
                                                 Text="{Binding ChamferRadius, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" Style="{StaticResource UnitText}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="减速角度" Style="{StaticResource FieldLabelText}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 Text="{Binding DecelAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="°" Style="{StaticResource UnitText}" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="停止角度" Style="{StaticResource FieldLabelText}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 Text="{Binding StopAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="5" Grid.Column="2" Text="°" Style="{StaticResource UnitText}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="* 控制器侧还没有确认的参数地址，界面保留、暂不下发。拐角模式 / 限制半径 / 最小速度（LSPEED）/ 减速角度 / 停止角度会写入 X、Y、Z 三轴。" />
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="{StaticResource SectionBackground}" Padding="12,7"
                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock Text="{Binding LastLookaheadMessage}" TextWrapping="Wrap" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastLookaheadFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ───────── ZTrackSmooth ───────── -->
                    <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource PanelHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ZTrackSmooth 参数" Style="{StaticResource PanelTitleText}" />
                                        <TextBlock Text="SMOOTHING" Style="{StaticResource CaptionText}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="保存平滑参数" Style="{StaticResource PrimaryButton}"
                                            Padding="10,4" Command="{Binding SaveZTrackSmoothCommand}" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" MinWidth="90" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="34" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="误差系数 *" Style="{StaticResource FieldLabelText}"
                                                   ToolTip="平滑引擎未接入，暂不下发" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 IsEnabled="False" ToolTip="平滑引擎未接入，暂不下发"
                                                 Text="{Binding ErrorFactor, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="" Style="{StaticResource UnitText}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SplineDis *" Style="{StaticResource FieldLabelText}"
                                                   ToolTip="平滑引擎未接入，暂不下发" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 IsEnabled="False" ToolTip="平滑引擎未接入，暂不下发"
                                                 Text="{Binding SplineDis, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" Style="{StaticResource UnitText}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CornerAcc *" Style="{StaticResource FieldLabelText}"
                                                   ToolTip="平滑引擎未接入，暂不下发" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 IsEnabled="False" ToolTip="平滑引擎未接入，暂不下发"
                                                 Text="{Binding CornerAcc, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="mm/s²" Style="{StaticResource UnitText}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="限速半径" Style="{StaticResource FieldLabelText}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 Text="{Binding SpeedLimitRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" Style="{StaticResource UnitText}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="限速值 *" Style="{StaticResource FieldLabelText}"
                                                   ToolTip="平滑引擎未接入，暂不下发" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource NumericInput}"
                                                 IsEnabled="False" ToolTip="平滑引擎未接入，暂不下发"
                                                 Text="{Binding SpeedLimitValue, Mode=TwoWay}" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="mm/s" Style="{StaticResource UnitText}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="* 这几项属于平滑引擎（SplineDis / CornerAcc / 误差系数 / 限速值），控制器侧参数地址尚未确认，界面保留、暂不下发。限速半径对应 SPLIMIT_RADIUS，会写入 X、Y、Z 三轴。" />
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="{StaticResource SectionBackground}" Padding="12,7"
                                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                                <TextBlock Text="{Binding LastZTrackMessage}" TextWrapping="Wrap" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastZTrackFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
